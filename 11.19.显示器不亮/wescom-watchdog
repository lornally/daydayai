#!/bin/zsh
# wescom-watchdog — 每个亮屏周期自动检查所有外接屏, 卡死时快速恢复
#
# 亮屏后 5 秒开始, 每 3 秒一轮, 共查 90 秒:
#   0. (默认关闭) 熄屏 ≥10 分钟的唤醒先主动重协商一次.
#      2026-11-28 用户反馈: 正常唤醒也会被切两下, 加上唤醒本身看起来像"唤醒 3 次".
#      现在不做预修复, 只靠 DDC 检测; 真卡死才修, 正常唤醒一次都不切.
#   A. CG 里 online=0 的其它屏: 只记录/通知, 不做任何软件接回或显示配置动作.
#      (11.27 实测: 对 sanguang 写 DDC 电源会立刻断链路; 11.26 全量配置也会.
#       这类屏不归本服务管, 恢复只有物理断电.)
#   B. 只对 WSM/wescom 屏动作: DDC 读不到(0/超时) 连续 3 次 -> fix-wescom
#      (自动只做同分辨率、向下换刷新率 + 软件拔插; 不改分辨率/缩放.
#       HiDPI <-> 1x 只在手动 fix-wescom -s 时做; DDC 电源默认不写.
#       DDC 亮度/电源状态只读, 从不写亮度——亮度是用户设置, 也不能唤醒显示器.)
#   C. 修复失败 -> 桌面通知.
#
# 判据: 正常时 DDC 能读到亮度 (>0); 卡死时读 0 或通信失败.
# 只在"显示器刚从灭变亮"后的窗口内动作, 正常熄屏/睡眠期间不动.
# 设计说明与各机器差异见同目录 README.md.

set -u
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

FIX="$HOME/.local/bin/fix-wescom"
DPFIX="$HOME/.local/bin/wescom-dpfix"
LOG="/tmp/wescom-watchdog.log"
INTERVAL=10          # 空闲轮询间隔
CHECK_INTERVAL=3     # 亮屏检查窗口内的轮询间隔
SCAN_EVERY=15        # offline 扫描最小间隔(秒)
START_DELAY=5        # 亮屏后等待 DDC/链路就绪
WINDOW=90            # 亮屏检查窗口(秒)
OFFLINE_NOTIFY_GAP=3600  # 非 WSM 屏离线通知最小间隔(秒), 避免每次唤醒都弹
PROACTIVE=0              # 预修复开关: 0 = 正常唤醒不动屏, 只在 DDC 转坏后修 (2026-11-28)
PROACTIVE_MIN_OFF=600    # 仅 PROACTIVE=1 时生效: 熄屏 ≥10 分钟的唤醒先主动重协商一次
ARCH=$(uname -m)

if [[ "$ARCH" == "arm64" ]]; then
  DDC="m1ddc"
  command -v m1ddc >/dev/null 2>&1 || brew install m1ddc >>"$LOG" 2>&1
else
  DDC="ddcctl"
  command -v ddcctl >/dev/null 2>&1 || brew install ddcctl >>"$LOG" 2>&1
fi

log() { echo "$(date '+%F %T') $*" >>"$LOG"; }

# 给命令加 5 秒超时: 固件卡死时 DDC 调用可能永久挂起
ddc_run() { perl -e 'alarm 5; exec @ARGV' -- "$@" 2>/dev/null; }

# 找 WSM 屏的 DDC 序号 (m1ddc 按厂商匹配, 不硬编码型号)
resolve_idx() {
  local idx=""
  if [[ "$DDC" == "m1ddc" ]]; then
    idx=$(ddc_run m1ddc display list detailed | awk '
      /^\[[0-9]+\] / { match($0,/^\[[0-9]+\]/); cur=substr($0,RSTART+1,RLENGTH-2); next }
      /- Manufacturer:[ \t]*WSM/ { print cur; exit }')
    [[ -z "$idx" ]] && idx=$(ddc_run m1ddc display list | awk '/^\[[0-9]+\] W[0-9]/{gsub(/[][]/,"",$1);print $1;exit}')
    # 不再用“最后一块屏”兜底: 多屏机器上会把别的屏当成 WSM, 导致误判正常.
  else
    idx=2
  fi
  print -r -- "${idx:-}"
}

# 读亮度; 空输出 = DDC 不可用/显示器缺失/卡死
read_lum() {
  local idx=$1
  if [[ "$DDC" == "m1ddc" ]]; then
    ddc_run m1ddc display "$idx" get luminance | tr -dc '0-9'
  else
    ddc_run ddcctl -d "$idx" -b | grep -i 'brightness' | grep -oE '[0-9]+' | tail -1
  fi
}

notify() {
  local msg=$1
  osascript -e "display notification \"$msg\" with title \"显示器\"" >/dev/null 2>&1 || true
  log "notify: $msg"
}

# 上一次熄屏时长 / 亮屏事件距现在多久(秒), 输出 "off_secs on_age"
display_times() {
  local ev off_line on_line off_ts on_ts off_e on_e now
  ev=$(pmset -g log 2>/dev/null | grep -E 'Display is turned (on|off)' | tail -2)
  off_line=$(print -r -- "$ev" | grep 'turned off' | tail -1)
  on_line=$(print -r -- "$ev" | grep 'turned on' | tail -1)
  if [[ -z "$off_line" || -z "$on_line" ]]; then
    print "0 99999"; return
  fi
  off_ts=$(print -r -- "$off_line" | awk '{print $1" "$2}')
  on_ts=$(print -r -- "$on_line" | awk '{print $1" "$2}')
  off_e=$(date -j -f "%Y-%m-%d %H:%M:%S" "$off_ts" +%s 2>/dev/null)
  on_e=$(date -j -f "%Y-%m-%d %H:%M:%S" "$on_ts" +%s 2>/dev/null)
  now=$(date +%s)
  if [[ -z "$off_e" || -z "$on_e" ]] || (( on_e <= off_e )); then
    print "0 99999"; return
  fi
  local age=$(( now - on_e ))
  (( age < 0 )) && age=99999
  print "$(( on_e - off_e )) $age"
}

display_name_for_vendor() {
  case "$1" in
    0x00005E6D|0x5E6D) echo "wescom(WSM)" ;;
    0x0000626C|0x626C) echo "sanguang(L32J1/XSL)" ;;
    *) echo "厂商 $1 的屏" ;;
  esac
}

# 非 WSM 屏 offline 时只记录/通知, 绝不尝试软件接回或任何显示配置动作.
# 边界: 11.27 实测对 sanguang(XSL) 写 DDC 电源会立刻断链路; 11.26 全量配置同样.
# 这类屏只能物理断电恢复, 软件动作只会增加风险.
report_offline() {
  local line cgid vend name
  [[ -x "$DPFIX" ]] || return 0
  for line in ${(f)"$("$DPFIX" list 2>/dev/null)"}; do
    [[ "$line" == *"online=0"* ]] || continue
    cgid=${${line%% *}#id=}
    vend=${${line#*vendor=}%% *}
    [[ "$vend" == "0x00005E6D" ]] && continue   # WSM 走主流程
    name=$(display_name_for_vendor "$vend")
    if (( offline_notified == 0 )); then
      offline_notified=1
      log "offline non-WSM display $cgid $name -> not touched (boundary)"
      # 每台机器每次唤醒都可能看到它; 通知限频, 避免刷屏
      if (( now - last_offline_notify >= OFFLINE_NOTIFY_GAP )); then
        last_offline_notify=$now
        notify "$name 不在线（链路断了）。看护服务不会动它（软件接回会加重问题）；请拔它的电源线等 15 秒再插回。"
      fi
    fi
  done
}

# WSM 不在 DDC 列表里时判断它的真实状态:
#   返回 0 = CG 里 online (DDC 挂了, 算一次坏读数)
#   返回 1 = CG 里 offline, 软件接回成功
#   返回 2 = 链路断了/系统里没有, 已通知, 本轮放弃
handle_wsm_missing() {
  local out wsm_line cgid
  [[ -x "$DPFIX" ]] || return 0
  out=$("$DPFIX" find 2>/dev/null)
  if print -r -- "$out" | grep -q 'online=1'; then
    log "WSM online in CG but DDC list unavailable (DDC dead)"
    return 0
  fi
  wsm_line=$(print -r -- "$out" | awk '$2=="online=0"{print;exit}')
  if [[ -n "$wsm_line" ]]; then
    cgid=${wsm_line%% *}
    log "WSM offline in CG -> try software reconnect (id $cgid)"
    "$DPFIX" on "$cgid" >/dev/null 2>&1
    sleep 2
    if [[ -n "$(resolve_idx)" ]]; then
      log "WSM reconnected by software"
      return 1
    fi
    log "WSM software reconnect failed"
    notify "wescom(WSM) 视频链路掉了，软件接不回。请拔掉它的电源线等 15 秒再插回；按电源键或马上插回都没用。"
  else
    log "WSM not present in CG at all"
    notify "系统里看不到 wescom(WSM) 屏了（线松/断电？），请检查它的视频线和电源。"
  fi
  return 2
}

prev=off
armed=1
check_start=$(( $(date +%s) + 15 ))   # 开机/登录后先等 DDC 就绪
deadline=$(( $(date +%s) + 15 + WINDOW ))
bad=0
saved=0
pending_restore=0
restore_deadline=0
offline_notified=0
last_offline_notify=0
last_scan=0
proactive=0
off_secs=0

while true; do
  last=$(pmset -g log 2>/dev/null | grep -E 'Display is turned (on|off)' | tail -1)
  case "$last" in
    *"turned on"*) state=on ;;
    *)             state=off ;;
  esac

  now=$(date +%s)

  # 上次重协商把屏踢掉后: 等它重新出现, 自动恢复原 HiDPI/布局
  if (( pending_restore )); then
    if (( now < restore_deadline )); then
      idx=$(resolve_idx)
      if [[ -n "$idx" ]]; then
        log "display reappeared, restoring layout"
        "$FIX" --restore >>"$LOG" 2>&1
        sleep 2
        lum=$(read_lum "$idx")
        pending_restore=0
        if [[ -n "$lum" && "$lum" -gt 0 ]]; then
          log "layout restored, display ok (lum=$lum)"
          notify "显示器已重新接入，原 HiDPI/布局已恢复。"
        else
          log "layout restored but display still black (lum=${lum:-none})"
          notify "显示器已重新接入、布局已恢复，但屏仍黑。请再拔插一次视频线。"
        fi
      fi
    else
      pending_restore=0
      log "restore window expired"
    fi
  fi

  if [[ "$state" == "on" && "$prev" != "on" ]]; then
    armed=1; bad=0; saved=0; offline_notified=0; last_scan=0
    check_start=$((now+START_DELAY))
    deadline=$((now+WINDOW))
    proactive=0
    read off_secs on_age <<<"$(display_times)"
    log "display on (off ${off_secs}s) -> checking in ${START_DELAY}s"
    # 长睡唤醒: 面板可能从唤醒起就是黑的, 但 DDC 还一直返回旧亮度(实测能骗 20+ 秒).
    # 这种情况下等到 DDC 变坏再修要多花半分钟, 所以主动先做一次换刷新率.
    # on_age 用来排除"看护服务刚重启时把很久前的亮屏当成新唤醒".
    if (( PROACTIVE && off_secs >= PROACTIVE_MIN_OFF && on_age <= 120 )); then
      proactive=1
      log "long display sleep (${off_secs}s) -> proactive retrain planned"
    fi
  fi
  prev=$state

  if [[ "$state" == "on" && "$armed" -eq 1 ]]; then
    if (( now > deadline )); then
      armed=0
      log "check window closed"
    elif (( now >= check_start )); then

      # A. 其它屏 offline: 只记录/通知, 不做任何动作 (边界)
      if (( now - last_scan >= SCAN_EVERY )); then
        last_scan=$now
        report_offline
      fi

      idx=$(resolve_idx)
      if [[ -z "$idx" ]]; then
        handle_wsm_missing
        case $? in
          0) lum="" ;;            # CG 在线但 DDC 死了: 按坏读数处理
          1) idx=$(resolve_idx); lum=$(read_lum "$idx") ;;
          2) armed=0; lum="" ;;   # 链路断了, 已通知
        esac
      else
        lum=$(read_lum "$idx")
      fi

      # 长睡唤醒的预修复: 只在 DDC 报"健康"时做 (说明正处在假健康盲区);
      # DDC 已经是坏的, 交给正常检测/修复流程, 避免白闪两次.
      if (( proactive )); then
        proactive=0
        if [[ -n "$idx" && -n "$lum" && "$lum" -gt 0 ]]; then
          log "proactive retrain (off ${off_secs}s, lum=$lum)"
          "$FIX" --force >>"$LOG" 2>&1
          sleep 1
          idx=$(resolve_idx)
          if [[ -n "$idx" ]]; then
            lum=$(read_lum "$idx")
          else
            lum=""
          fi
          log "proactive retrain done (idx=${idx:-none} lum=${lum:-none})"
        else
          log "proactive retrain skipped (display already reporting bad: lum=${lum:-none})"
        fi
      fi

      if [[ "$armed" -eq 1 ]]; then
        if [[ -z "$lum" || "$lum" -eq 0 ]]; then
          bad=$((bad+1))
          log "bad reading ${bad}/3 (idx=${idx:-none} lum=${lum:-none})"
        else
          bad=0
          # 健康时保存一份完整配置, 供软件重连后的 --restore 用
          # (fix-wescom --save 自己会拒绝用残缺配置覆盖完整配置)
          if (( saved == 0 )) && [[ -x "$FIX" ]]; then
            # 记一次 DDC 特征值: 下次排查“面板黑但 DDC 报健康”时对比用
            standby=""
            [[ "$DDC" == "m1ddc" && -n "$idx" ]] && standby=$(ddc_run m1ddc display "$idx" get standby | tr -dc '0-9')
            log "health ok (idx=$idx lum=$lum standby=${standby:-none})"
            "$FIX" --save >>"$LOG" 2>&1
            saved=1
          fi
        fi
      fi

      if (( bad >= 3 )); then
        armed=0; bad=0
        log "WSM stuck, running fix-wescom"
        "$FIX" >>"$LOG" 2>&1
        sleep 3
        idx=$(resolve_idx)
        if [[ -z "$idx" ]]; then
          lum=""
        else
          lum=$(read_lum "$idx")
        fi
        if [[ -z "$lum" || "$lum" -eq 0 ]]; then
          log "fix failed (idx=${idx:-none} lum=${lum:-none})"
          if [[ -f "$HOME/.local/state/wescom-last-config" ]]; then
            pending_restore=1
            restore_deadline=$(( $(date +%s) + 1800 ))
          fi
          notify "wescom(WSM) 卡死，自动恢复失败。请拔掉它的电源线等 15 秒再插回（按电源键没用）；插回后会自动恢复原布局。"
        else
          log "fix ok (lum=$lum)"
        fi
      fi
    fi
  fi

  if (( armed )); then
    sleep $CHECK_INTERVAL
  else
    sleep $INTERVAL
  fi
done
